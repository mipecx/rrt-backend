# environment
APP_ENV=local
HTTP_PORT=:8080

# PostgreSQL config
DB_HOST=localhost
DB_PORT=5432
DB_USER=username
DB_PASSWORD=password
DB_NAME=db_name
DB_SSLMODE=disable

# Redis config
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password

JWT_SECRET=secret
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=720h

# Comma-separated list of allowed CORS/WebSocket origins.
# Add your production frontend domain here when the server is rented.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Twilio
SMS_ACCOUNT_SID=your_twilio_sid
SMS_AUTH_TOKEN=your_twilio_token
SMS_FROM_PHONE=your_twilio_phone
